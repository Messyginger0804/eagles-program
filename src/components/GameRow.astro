---
import { withBase } from '../lib/url';
import type { Game } from '../lib/schema';
import { kickoffLabel, gameBadges, gameLabel, shortDate, siteLabel } from '../lib/format';
const { game } = Astro.props as { game: Game };
const badges = gameBadges(game);
---
<tr>
  <th scope="row">{shortDate(game.date)}</th>
  <td>
    <a href={withBase(`/games/${game.id}`)}>{gameLabel(game)}</a>
    {badges.length > 0 && <span class="muted"> · {badges.map((b) => b.label).join(' · ')}</span>}
    {game.status === 'scheduled' && <span class="muted"> · {game.kickoffTime && `${kickoffLabel(game.kickoffTime)} · `}{siteLabel(game)}</span>}
  </td>
  <td class="res">
    {game.score && game.result
      ? <><strong class={`wl wl--${game.result}`}>{game.result}</strong> {game.score.wh}-{game.score.opp}</>
      : <span class="muted">TBA</span>}
  </td>
</tr>
