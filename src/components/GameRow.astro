---
import { withBase } from '../lib/url';
import type { Game } from '../lib/schema';
import { gameLabel, shortDate, locationLabel } from '../lib/format';
const { game } = Astro.props as { game: Game };
---
<tr>
  <th scope="row">{shortDate(game.date)}</th>
  <td>
    <a href={withBase(`/games/${game.id}`)}>{gameLabel(game)}</a>
    <span class="badges">
      {game.districtGame && <span class="badge">District</span>}
      {game.playoff && <span class="badge badge--solid">Playoff{game.round ? ` · ${game.round}` : ''}</span>}
    </span>
    {game.status === 'scheduled' && <span class="muted"> · {locationLabel(game.location)}</span>}
  </td>
  <td class="res">
    {game.score && game.result
      ? <><strong class={`wl wl--${game.result}`}>{game.result}</strong> {game.score.wh}-{game.score.opp}</>
      : <span class="muted">TBA</span>}
  </td>
</tr>
