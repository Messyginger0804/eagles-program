---
import { withBase } from '../../lib/url';
import Program from '../../layouts/Program.astro';
import StatCaveat from '../../components/StatCaveat.astro';
import { getRoster, getSeasonStats, getGames, getGame, getPlayer } from '../../lib/data';
import { playerSeasonStats, playerGameLog } from '../../lib/season';
import { nonEmptyCategories } from '../../lib/statcards';
import { byNumber, gradeLabel, shortDate, playDesc, takeawayLabel, fmtStat } from '../../lib/format';
import type { Player } from '../../lib/schema';

export function getStaticPaths() {
  const sorted = byNumber(getRoster().players);
  return sorted.map((p, i) => ({
    params: { slug: p.slug },
    props: { prev: sorted[i - 1]?.slug ?? null, next: sorted[i + 1]?.slug ?? null },
  }));
}
const { slug } = Astro.params;
const { prev, next } = Astro.props as { prev: string | null; next: string | null };
const roster = getRoster();
const player = getPlayer(slug!)!;
const stats = getSeasonStats();
const cats = nonEmptyCategories(playerSeasonStats(roster, stats, player));
const log = playerGameLog(roster, getGames(), player);
const name = `${player.firstName} ${player.lastName}`;
const nb = (s: string | null) => (s ? getPlayer(s) : undefined) as Player | undefined;
const prevP = nb(prev), nextP = nb(next);
const entries = log.flatMap((e) => {
  const g = getGame(e.gameId)!;
  const when = `${shortDate(e.date)} · ${g.location === 'away' ? 'at' : 'vs.'} ${e.opponent}`;
  return [
    ...e.scoring.map((s) => ({ id: e.gameId, when, text: `Q${s.play.quarter} ${playDesc(s.play, s.role)}` })),
    ...e.takeaways.map((t) => ({ id: e.gameId, when, text: `Q${t.quarter} ${takeawayLabel(t.type).toLowerCase()}` })),
  ];
});
---
<Program title={`#${player.number} ${name}`}>
  <p class="backlink"><a href={withBase("/roster")}>&larr; Roster</a></p>
  <section class="phero" aria-labelledby="pname">
    <p class="phero__num" aria-hidden="true">{player.number}</p>
    <div class="phero__body">
      <h1 id="pname" class="phero__name"><span class="sr-only">Number {player.number}, </span>{player.firstName} <span>{player.lastName}</span></h1>
      <p class="phero__pos">
        {player.positions.length ? player.positions.map((x) => <span class="pos">{x}</span>) : <span class="muted">No position listed</span>}
      </p>
      <ul class="vitals">
        <li><span>Grade</span>{gradeLabel(player.grade)}</li>
        <li><span>Height</span>{player.height ?? '—'}</li>
        <li><span>Weight</span>{player.weight ? `${player.weight} lbs` : '—'}</li>
      </ul>
    </div>
  </section>

  <h2 class="section-title">Season Stats</h2>
  {cats.length === 0
    ? <p class="card muted">No stats recorded yet.</p>
    : <div class="statcards">{cats.map((c) => (
      <section class="card statcard avoid-break" aria-label={`${c.label} season stats`}>
        <h3>{c.label}</h3>
        <dl class="statgrid">
          {c.stats.gp != null && <div><dt>GP</dt><dd>{fmtStat(c.stats.gp)}</dd></div>}
          {c.columns.map((col) => <div><dt>{col.label}</dt><dd>{fmtStat(c.stats[col.key])}</dd></div>)}
        </dl>
      </section>
    ))}</div>}
  <StatCaveat games={stats.gamesPlayed} />

  <h2 class="section-title">Game Log</h2>
  {entries.length === 0
    ? <p class="card muted">No scoring plays or takeaways recorded for this player in the games reported so far.</p>
    : <ol class="gamelog">
        {entries.map((e) => <li class="card"><a href={withBase(`/games/${e.id}`)}>{e.when}</a><strong>{e.text}</strong></li>)}
      </ol>}
  <p class="caveat">Play logs on MaxPreps are incomplete for most games.</p>

  <h2 class="section-title">Links</h2>
  <ul class="linklist">
    <li><a class="btn btn--ghost" href={player.maxprepsUrl} rel="noopener">MaxPreps profile</a></li>
    {player.highlights.map((h) => <li><a class="btn btn--ghost" href={h.url} rel="noopener">{h.label}</a></li>)}
  </ul>

  <nav class="pager" aria-label="Other players">
    {prevP ? <a href={withBase(`/players/${prevP.slug}`)} rel="prev">&larr; #{prevP.number} {prevP.firstName} {prevP.lastName}</a> : <span></span>}
    {nextP ? <a href={withBase(`/players/${nextP.slug}`)} rel="next">#{nextP.number} {nextP.firstName} {nextP.lastName} &rarr;</a> : <span></span>}
  </nav>
</Program>
