---
import { withBase } from '../lib/url';
import Program from '../layouts/Program.astro';
import { getRoster } from '../lib/data';
import { byNumber, gradeLabel, positionGroups } from '../lib/format';
const roster = getRoster();
const players = byNumber(roster.players);
---
<Program title="Roster">
  <h1 class="page-title">Roster</h1>
  <p class="muted">{players.length} players. Name, number, position, grade, height and weight only.</p>

  <div id="controls" class="controls" hidden>
    <label for="q" class="sr-only">Search by number or name</label>
    <input class="search" id="q" type="search" inputmode="search" autocomplete="off" placeholder="Search a number or name" />
    <div class="chips" role="group" aria-label="Filter by position group">
      <button type="button" class="chip" data-group="all" aria-pressed="true">All</button>
      <button type="button" class="chip" data-group="offense" aria-pressed="false">Offense</button>
      <button type="button" class="chip" data-group="defense" aria-pressed="false">Defense</button>
      <button type="button" class="chip" data-group="special" aria-pressed="false">Special Teams</button>
    </div>
    <p id="count" class="count" role="status" aria-live="polite"></p>
  </div>

  <ul class="rgrid" id="roster-grid">
    {players.map((p) => (
      <li data-num={p.number} data-name={`${p.firstName} ${p.lastName}`.toLowerCase()} data-groups={positionGroups(p.positions).join(' ')}>
        <a class="pc" href={withBase(`/players/${p.slug}`)} aria-label={`Number ${p.number}, ${p.firstName} ${p.lastName}`}>
          <span class="pc__num" aria-hidden="true">{p.number}</span>
          <span class="pc__body">
            <span class="pc__name">{p.firstName} {p.lastName}</span>
            <span class="pc__pos">
              {p.positions.length ? p.positions.map((x) => <span class="pos">{x}</span>) : <span class="muted">No position listed</span>}
            </span>
            <span class="pc__vitals">{[gradeLabel(p.grade) === '—' ? null : gradeLabel(p.grade), p.height, p.weight ? `${p.weight} lbs` : null].filter(Boolean).join(' · ')}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p id="empty" class="empty" hidden>No players match. Try a different number or name, or choose All.</p>

  <script is:inline>
    (function () {
      var controls = document.getElementById('controls');
      var rows = Array.prototype.slice.call(document.querySelectorAll('#roster-grid > li'));
      var input = document.getElementById('q');
      var count = document.getElementById('count');
      var empty = document.getElementById('empty');
      var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
      var group = 'all';
      controls.hidden = false;
      var norm = function (s) { return s.toLowerCase().replace(/[^a-z0-9 ]/g, ''); };
      function apply() {
        var q = norm(input.value.trim());
        var terms = q.split(/\s+/).filter(Boolean);
        var shown = 0;
        rows.forEach(function (li) {
          var ok = true;
          if (/^\d+$/.test(q)) ok = li.dataset.num === q;
          else if (terms.length) ok = terms.every(function (t) { return norm(li.dataset.name).indexOf(t) !== -1; });
          if (ok && group !== 'all') ok = (' ' + li.dataset.groups + ' ').indexOf(' ' + group + ' ') !== -1;
          li.hidden = !ok;
          if (ok) shown++;
        });
        count.textContent = 'Showing ' + shown + ' of ' + rows.length + ' players';
        empty.hidden = shown !== 0;
        var url = new URL(location.href);
        if (input.value.trim()) url.searchParams.set('q', input.value.trim()); else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }
      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          group = c.dataset.group;
          chips.forEach(function (x) { x.setAttribute('aria-pressed', String(x === c)); });
          apply();
        });
      });
      input.addEventListener('input', apply);
      input.value = new URLSearchParams(location.search).get('q') || '';
      apply();
    })();
  </script>
</Program>
