---
import { withBase } from '../lib/url';
import Program from '../layouts/Program.astro';
import StatCaveat from '../components/StatCaveat.astro';
import { getTeam, getRoster, getSeasonStats } from '../lib/data';
import { seniors } from '../lib/season';
import { byNumber, statHighlight, paragraphs } from '../lib/format';
import { WELCOME_NOTE } from '../config';
const team = getTeam(), roster = getRoster(), stats = getSeasonStats();
const srs = byNumber(seniors(roster)).map((p) => ({ p, hl: statHighlight(roster, stats, p) }));
---
<Program title="Seniors & Coaches">
  <h1>Seniors &amp; Coaches</h1>
  <h2>Welcome</h2>
  <div class="welcome">{paragraphs(WELCOME_NOTE).map((t) => <p>{t}</p>)}</div>

  <h2>The Seniors</h2>
  <p>{srs.length} seniors. Thank you for everything.</p>
  <ul class="cards">
    {srs.map(({ p, hl }) => (
      <li><div class="senior avoid-break">
        <p class="numeral" aria-label={`Number ${p.number}`}>{p.number}</p>
        <h3>{p.firstName} {p.lastName}</h3>
        <p>{p.positions.join(' / ') || 'Position not listed'}</p>
        {hl && <p class="muted">{hl} this season</p>}
        <p><a href={withBase(`/players/${p.slug}`)}>Player page<span class="sr-only"> for {p.firstName} {p.lastName}</span></a></p>
      </div></li>
    ))}
  </ul>
  {srs.some((s) => s.hl) && <StatCaveat games={stats.gamesPlayed} />}

  <h2>Coaching Staff</h2>
  <ul class="cards">
    {team.coaches.map((c) => <li><div class="senior"><h3>{c.name}</h3><p class="muted">{c.role}</p></div></li>)}
  </ul>
</Program>
