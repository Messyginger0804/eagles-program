---
import { withBase } from '../lib/url';
import Program from '../layouts/Program.astro';
import PbpTouchdowns from '../components/PbpTouchdowns.astro';
import StatsSource from '../components/StatsSource.astro';
import StatCaveat from '../components/StatCaveat.astro';
import { getRoster, getSeasonStats, getGames } from '../lib/data';
import { playByPlayTouchdowns } from '../lib/season';
import { realRows } from '../lib/statcards';
import { playerForStatRow, primaryKey, fmtStat, shortDate } from '../lib/format';
const stats = getSeasonStats();
const roster = getRoster();
const pbp = playByPlayTouchdowns(roster, getGames());
const OFFENSE = ['passing', 'rushing', 'receiving'];
const lastOffense = stats.categories.reduce((acc, c, i) => (OFFENSE.includes(c.key) ? i : acc), -1);
const insertAt = lastOffense >= 0 ? lastOffense : -1;
---
<Program title="Stats">
  <h1 class="page-title">Season Stats</h1>
  <p class="muted">
    As of {stats.asOf ? shortDate(stats.asOf) : `${stats.gamesPlayed} games played`}.
    Top 3 in each category, then the full table (sortable by column heading).
  </p>
  <StatCaveat games={stats.gamesPlayed} />
  <StatsSource />
  <nav aria-label="Stat categories" class="chipnav"><ul class="chips">
    {stats.categories.map((c) => <li><a class="chip" href={`#${c.key}`}>{c.label}</a></li>)}
  </ul></nav>

  {stats.categories.map((c, ci) => {
    const pk = primaryKey(c);
    const pkLabel = c.columns.find((x) => x.key === pk)?.label ?? '';
    const rows = [...realRows(c.rows)].sort((a, b) => (b.stats[pk] ?? -Infinity) - (a.stats[pk] ?? -Infinity));
    const top = rows.slice(0, 3).filter((r) => (r.stats[pk] ?? 0) > 0).map((r) => ({ number: r.number, nameAbbrev: r.nameAbbrev, value: r.stats[pk] as number }));
    const who = (r: { number: string; nameAbbrev: string }) => {
      const pl = playerForStatRow(roster, r);
      return pl ? { name: `${pl.firstName} ${pl.lastName}`, href: withBase(`/players/${pl.slug}`) } : { name: r.nameAbbrev, href: null };
    };
    return (<>
      <section id={c.key} class="statsec" aria-labelledby={`h-${c.key}`}>
        <h2 id={`h-${c.key}`} class="section-title">{c.label}</h2>
        {rows.length === 0 && <p class="card muted">{c.label} stats haven't been entered on MaxPreps by the team's stat keeper yet.</p>}
        {rows.length > 0 && top.length === 0 && <p class="muted">No {pkLabel} recorded yet.</p>}
        {top.length > 0 && (
          <ol class="podium" aria-label={`${c.label} top ${top.length}, by ${pkLabel}`}>
            {top.map((r, i) => {
              const w = who(r);
              return (
                <li class={`lead lead--${i + 1}`}>
                  <span class="lead__rank" aria-hidden="true">{i + 1}</span>
                  <span class="lead__num" aria-hidden="true">#{r.number}</span>
                  <span class="lead__name">{w.href ? <a href={w.href}>{w.name}</a> : w.name}</span>
                  <span class="lead__val"><strong>{r.value}</strong> {pkLabel}</span>
                </li>
              );
            })}
          </ol>
        )}
        {rows.length > 0 && <details class="fulltable">
          <summary>Full table ({rows.length})</summary>
          <div class="table-scroll" role="region" tabindex="0" aria-label={`${c.label} full table`}>
            <table class="sortable">
              <caption class="sr-only">{c.label}, sorted by {pkLabel}</caption>
              <thead><tr>
                <th scope="col" class="num">#</th>
                <th scope="col">Player</th>
                <th scope="col" class="num" aria-sort="none" data-key="gp"><button type="button">GP</button></th>
                {c.columns.map((col) => (
                  <th scope="col" class="num" aria-sort={col.key === pk ? 'descending' : 'none'} data-key={col.key}><button type="button">{col.label}</button></th>
                ))}
              </tr></thead>
              <tbody>
                {rows.map((r) => {
                  const w = who(r);
                  return (
                    <tr>
                      <th scope="row" class="num">{r.number}</th>
                      <td class="wrap">{w.href ? <a href={w.href}>{w.name}</a> : w.name}</td>
                      <td class="num" data-v={r.stats.gp ?? ''}>{fmtStat(r.stats.gp)}</td>
                      {c.columns.map((col) => <td class="num" data-v={r.stats[col.key] ?? ''}>{fmtStat(r.stats[col.key])}</td>)}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </details>}
      </section>
      {ci === insertAt && <PbpTouchdowns rows={pbp.rows} coverage={pbp.coverage} />}
    </>);
  })}
  {insertAt < 0 && <PbpTouchdowns rows={pbp.rows} coverage={pbp.coverage} />}

  <script is:inline>
    document.querySelectorAll('table.sortable').forEach(function (table) {
      var tb = table.tBodies[0];
      var ths = Array.prototype.slice.call(table.tHead.rows[0].cells);
      ths.forEach(function (th, idx) {
        var btn = th.querySelector('button');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var dir = th.getAttribute('aria-sort') === 'descending' ? 'ascending' : 'descending';
          ths.forEach(function (o) { if (o.hasAttribute('aria-sort')) o.setAttribute('aria-sort', 'none'); });
          th.setAttribute('aria-sort', dir);
          var rows = Array.prototype.slice.call(tb.rows);
          var val = function (r) { var v = r.cells[idx].dataset.v; return v === '' ? null : parseFloat(v); };
          rows.sort(function (a, b) {
            var x = val(a), y = val(b);
            if (x === null && y === null) return 0;
            if (x === null) return 1;
            if (y === null) return -1;
            return dir === 'descending' ? y - x : x - y;
          });
          rows.forEach(function (r) { tb.appendChild(r); });
        });
      });
    });
  </script>
</Program>
