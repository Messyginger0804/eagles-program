---
import { withBase } from '../lib/url';
import Program from '../layouts/Program.astro';
import RosterTable from '../components/RosterTable.astro';
import { splitRecord, LEADER_STATS, topLeader } from '../lib/season';
import { getTeam, getRoster, getSeasonStats, getNextGame, getOpponent, getGames } from '../lib/data';
import { kickoffLabel, recordStr, splitRecordLine, roundName, shortDate, longDate, opponentSlug, siteLabel, mapsUrl, WH_NAME } from '../lib/format';
const team = getTeam();
const roster = getRoster();
const game = getNextGame();
const opp = game ? getOpponent(opponentSlug(game)) : undefined;
const head = (c: { name: string; role: string }[]) => c.find((x) => /head/i.test(x.role))?.name ?? 'TBA';
const whSplit = splitRecordLine(splitRecord(getGames()));
const whStats = getSeasonStats();
const leaderRows = LEADER_STATS.map((s) => ({
  label: s.label,
  wh: topLeader(whStats, s.category, s.column),
  opp: topLeader(opp?.seasonStats ?? null, s.category, s.column),
}));
const showLeaders = leaderRows.some((r) => r.opp);
const whResults = getGames().filter((g) => g.score);
---
<Program title="Matchup">
  <h1 class="page-title">Matchup</h1>
  {!game ? <p class="card lede">No upcoming game is scheduled yet.</p> : (
    <>
      {roundName(game) && <p class="matchup-round">{roundName(game)} · vs. {game.opponent.name}{game.opponent.mascot ? ` ${game.opponent.mascot}` : ''}</p>}
      <section class="versus" aria-label="Matchup">
        <div class="versus__team">
          <span class="versus__abbr">WH</span>
          <span class="versus__name">{WH_NAME} {team.mascot}</span>
          <span class="versus__rec">{recordStr(team.record.overall)}</span>
        </div>
        <div class="versus__vs" aria-hidden="true">VS</div>
        <div class="versus__team versus__team--opp">
          <span class="versus__abbr">{game.opponent.name.slice(0, 3).toUpperCase()}</span>
          <span class="versus__name">{game.opponent.name} {game.opponent.mascot ?? ''}</span>
          <span class="versus__rec">{opp ? recordStr(opp.record.overall) : '—'}</span>
        </div>
        <p class="versus__note"><span class="sr-only">Versus. </span>Both teams are the Eagles, so look for the school name.</p>
      </section>

      <dl class="facts">
        <div><dt>{WH_NAME} record</dt><dd>{recordStr(team.record.overall)} ({recordStr(team.record.district)} district)<span class="facts__sub">{whSplit}</span></dd></div>
        <div><dt>{game.opponent.name} record</dt><dd>{opp ? `${recordStr(opp.record.overall)}${opp.record.district ? ` (${recordStr(opp.record.district)} district)` : ''}` : 'Not available'}</dd></div>
        <div><dt>{WH_NAME} head coach</dt><dd>{head(team.coaches)}</dd></div>
        <div><dt>{game.opponent.name} head coach</dt><dd>{opp ? head(opp.coaches) : 'TBA'}</dd></div>
        <div><dt>Date</dt><dd>{game.date ? longDate(game.date) : 'TBA'}</dd></div>
        <div><dt>Kickoff</dt><dd>{game.kickoffTime ? kickoffLabel(game.kickoffTime) : `TBA${game.date ? ' (time not announced)' : ''}`}</dd></div>
        <div><dt>Site</dt><dd>{siteLabel(game)}{game.venue && <> · <a href={mapsUrl(game.venue)} target="_blank" rel="noopener">{game.venue.address}<span class="sr-only"> (opens maps in a new tab)</span></a></>}</dd></div>
      </dl>
      {game.opponent.maxprepsTeamUrl && <p class="linkrow"><a href={game.opponent.maxprepsTeamUrl} target="_blank" rel="noopener noreferrer">{game.opponent.name} on MaxPreps<span class="sr-only"> (opens in a new tab)</span></a></p>}
      {game.maxprepsUrl && <p class="linkrow"><a href={game.maxprepsUrl} rel="noopener">Game page on MaxPreps</a> · <a href={withBase(`/games/${game.id}`)}>Game page here</a></p>}

      {showLeaders && (
        <>
          <h2 class="section-title">{game.opponent.name} Leaders</h2>
          <div class="table-scroll" role="region" tabindex="0" aria-label="Season leaders, both teams"><table class="matchup-leaders">
            <caption class="sr-only">Season leaders for {WH_NAME} and {game.opponent.name}</caption>
            <colgroup><col style="width: 24%" /><col style="width: 38%" /><col style="width: 38%" /></colgroup>
            <thead><tr><th scope="col">Stat</th><th scope="col"><abbr title={WH_NAME}>WH</abbr></th><th scope="col">{game.opponent.name}</th></tr></thead>
            <tbody>{leaderRows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.wh ? <><span class="matchup-leaders__name">{r.wh.nameAbbrev}</span> <strong>{r.wh.value}</strong></> : '—'}</td>
                <td>{r.opp ? <><span class="matchup-leaders__name">{r.opp.nameAbbrev}</span> <strong>{r.opp.value}</strong></> : '—'}</td>
              </tr>
            ))}</tbody>
          </table></div>
          <p class="caveat">Season totals as entered on MaxPreps{opp?.seasonStats?.gamesPlayed ? ` through ${opp.seasonStats.gamesPlayed} games` : ''}; may be incomplete.</p>
        </>
      )}

      <h2 class="section-title">Rosters</h2>
      <div class="fold__tabs chips no-print" id="fold-tabs" role="group" aria-label="Choose a roster" hidden>
        <button type="button" class="chip" data-t="wh" aria-pressed="true">{WH_NAME}</button>
        <button type="button" class="chip" data-t="opp" aria-pressed="false">{game.opponent.name}</button>
      </div>
      <div class="fold" id="fold">
        <section class="fold__panel" data-p="wh" aria-labelledby="fold-wh">
          <h3 class="fold__h" id="fold-wh">{WH_NAME} Eagles</h3>
          <RosterTable rows={roster.players} caption={`${WH_NAME} Eagles numerical roster`} compact />
        </section>
        <section class="fold__panel" data-p="opp" aria-labelledby="fold-opp">
          <h3 class="fold__h" id="fold-opp">{game.opponent.name} {game.opponent.mascot ?? ''}</h3>
          {opp
            ? <RosterTable rows={opp.roster} caption={`${game.opponent.name} numerical roster`} compact />
            : <p>Roster not available yet.</p>}
        </section>
      </div>

      <h2 class="section-title">Season Results</h2>
      <div class="fold">
        <section>
          <h3 class="fold__h">{WH_NAME}</h3>
          <div class="table-scroll" role="region" tabindex="0" aria-label={`${WH_NAME} results`}><table>
            <caption class="sr-only">{WH_NAME} results</caption>
            <thead><tr><th scope="col">Date</th><th scope="col">Opponent</th><th scope="col">Result</th></tr></thead>
            <tbody>{whResults.map((g) => (
              <tr><th scope="row">{shortDate(g.date)}</th><td>{g.location === 'away' ? 'at' : 'vs.'} {g.opponent.name}</td><td>{g.result} {g.score!.wh}-{g.score!.opp}</td></tr>
            ))}</tbody>
          </table></div>
        </section>
        <section>
          <h3 class="fold__h">{game.opponent.name}</h3>
          {opp ? (
            <div class="table-scroll" role="region" tabindex="0" aria-label={`${game.opponent.name} results`}><table>
              <caption class="sr-only">{game.opponent.name} results</caption>
              <thead><tr><th scope="col">Date</th><th scope="col">Opponent</th><th scope="col">Result</th></tr></thead>
              <tbody>{opp.results.map((r) => (
                <tr><th scope="row">{shortDate(r.date)}</th><td>{r.location === 'away' ? 'at' : 'vs.'} {r.opponent}</td><td>{r.score && r.result ? `${r.result} ${r.score.us}-${r.score.them}` : 'TBA'}</td></tr>
              ))}</tbody>
            </table></div>
          ) : <p>Results not available yet.</p>}
        </section>
      </div>
      <p class="caveat">Opponent rosters and results as listed on MaxPreps. Players are not linked to individual pages.</p>
    </>
  )}

  <script is:inline>
    (function () {
      var tabs = document.getElementById('fold-tabs'), fold = document.getElementById('fold');
      if (!tabs || !fold) return;
      tabs.hidden = false; fold.classList.add('has-tabs');
      var btns = tabs.querySelectorAll('button'), panels = fold.querySelectorAll('.fold__panel');
      function show(t) {
        btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.t === t)); });
        panels.forEach(function (p) { if (p.dataset.p === t) p.removeAttribute('data-off'); else p.setAttribute('data-off', ''); });
      }
      btns.forEach(function (b) { b.addEventListener('click', function () { show(b.dataset.t); }); });
      show('wh');
    })();
  </script>
</Program>
