---
import Program from '../layouts/Program.astro';
import GameCard from '../components/GameCard.astro';
import EventCard from '../components/EventCard.astro';
import { getTeam, getGames, getScheduleEvents } from '../lib/data';
import { recordStr } from '../lib/format';
import { PLAYOFFS_GIF, PLAYOFF_ROUNDS } from '../config';
import { gamesLeftLine, playoffOutlook } from '../lib/playoffs';
import { mergeSchedule, splitRecord } from '../lib/season';
const team = getTeam();
const games = getGames();
const finals = games.filter((g) => g.score);
const pf = finals.reduce((s, g) => s + g.score!.wh, 0);
const split = splitRecord(games);
const hasNeutral = split.neutral.w + split.neutral.l + split.neutral.t > 0;
const items = mergeSchedule(games, getScheduleEvents());
const hasPlayoff = games.some((g) => g.playoff);
const outlook = playoffOutlook(games, PLAYOFF_ROUNDS[team.season] ?? []);
const pa = finals.reduce((s, g) => s + g.score!.opp, 0);
---
<Program title="Schedule">
  <h1 class="page-title">Schedule &amp; Results</h1>
  <dl class="facts facts--tiles">
    <div><dt>Overall</dt><dd>{recordStr(team.record.overall)}</dd></div>
    <div><dt>District</dt><dd>{recordStr(team.record.district)}</dd></div>
    <div><dt>Home</dt><dd>{recordStr(split.home)}</dd></div>
    <div><dt>Away</dt><dd>{recordStr(split.away)}</dd></div>
    {hasNeutral && <div><dt>Neutral</dt><dd>{recordStr(split.neutral)}</dd></div>}
    <div><dt>PF / PA</dt><dd>{pf} / {pa}</dd></div>
  </dl>
  {hasPlayoff && (
    <figure class="pogif">
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset={PLAYOFFS_GIF.still} />
        <img src={PLAYOFFS_GIF.animated} width={PLAYOFFS_GIF.width} height={PLAYOFFS_GIF.height} loading="lazy" decoding="async" alt="Coach Jim Mora at a 2001 press conference shouting “Playoffs?!”" />
      </picture>
      <figcaption>
        <strong>Playoffs?! Yeah, PLAYOFFS.</strong>
        {outlook.gamesLeft > 0 && <span class="pogif__left">{gamesLeftLine(outlook.gamesLeft)}</span>}
        <span class="pogif__credit">Jim Mora, 2001 · via GIPHY</span>
      </figcaption>
    </figure>
  )}
  <ol class="glist">
    {items.map((i) => <li>
      {i.type === 'game' ? <GameCard game={i.game} /> : <EventCard event={i.event} />}
      {i.type === 'game' && i.game.opponent.maxprepsTeamUrl && (
        <p class="oplink"><a href={i.game.opponent.maxprepsTeamUrl} target="_blank" rel="noopener noreferrer">{i.game.opponent.name} on MaxPreps<span class="sr-only"> (opens in a new tab)</span></a></p>
      )}
    </li>)}
    {outlook.placeholders.map((r) => <li>
      <div class="gcard gcard--event gcard--tbd">
        <span class="gcard__main">
          <span class="gcard__opp">{r.name}</span>
          <span class="muted">If the Eagles advance</span>
          <span class="muted">{r.weekLabel} · {r.site ?? 'Site TBA'}</span>
        </span>
      </div>
    </li>)}
  </ol>
  <p class="caveat">Scores and records as reported on MaxPreps.</p>
</Program>
