---
import { withBase } from '../lib/url';
import Program from '../layouts/Program.astro';
import { getTeam, getNextGame, getOpponent } from '../lib/data';
import { recordStr, shortDate, opponentSlug, locationLabel } from '../lib/format';
const team = getTeam();
const next = getNextGame();
const opp = next ? getOpponent(opponentSlug(next)) : undefined;
const division = (team.classification ?? '').replace(/Division 1$/, 'Division I');
const links = [
  { href: '/roster', label: 'Roster', note: 'Numerical roster' },
  { href: '/schedule', label: 'Schedule', note: 'Results and what is next' },
  { href: '/matchup', label: 'This Week', note: 'Centerfold matchup' },
  { href: '/stats', label: 'Stats', note: 'Season leaders' },
  { href: '/seniors-coaches', label: 'Seniors & Coaches', note: 'Welcome note, seniors, staff' },
  { href: '/print', label: 'Print', note: 'Take it to the stands' },
];
---
<Program>
  <section class="cover avoid-break" aria-labelledby="cover-title">
    <p class="cover__masthead">Game Day Program · Fan Edition {team.season}</p>
    <h1 id="cover-title" class="cover__wordmark">Eagles</h1>
    <p class="cover__team">{team.school} {team.city}, {team.state}</p>
    <p class="cover__record" aria-label={`Record ${recordStr(team.record.overall)}, district ${recordStr(team.record.district)}`}>
      {recordStr(team.record.overall)}
    </p>
    <p class="cover__sub">({recordStr(team.record.district)} district)</p>
    <p class="cover__tag">{division} Playoffs</p>
  </section>

  {next && (
    <a class="card nextgame" href={withBase("/matchup")}>
      <h2>Next Game</h2>
      <p class="nextgame__vs">Wilmer-Hutchins {team.mascot} vs. {next.opponent.name}{next.opponent.mascot ? ` ${next.opponent.mascot}` : ''}</p>
      <p class="nextgame__meta">
        {shortDate(next.date)} · {locationLabel(next.location)}
        {opp && <> · {next.opponent.name} is {opp.record.overall.w}-{opp.record.overall.l}</>}
      </p>
      <p class="nextgame__cta">See the matchup</p>
    </a>
  )}

  <form class="card finder" action={withBase("/roster")} method="get" role="search">
    <label for="find">Find a player</label>
    <input id="find" type="search" name="q" placeholder="Number or name" autocomplete="off" />
    <button class="btn" type="submit">Search</button>
  </form>

  <h2>Inside this program</h2>
  <ul class="links">
    {links.map((l) => <li><a href={withBase(l.href)}>{l.label}<small>{l.note}</small></a></li>)}
  </ul>
</Program>
