---
import { withBase } from '../lib/url';
import Program from '../layouts/Program.astro';
import Logo from '../components/Logo.astro';
import { getTeam, getRoster, getSeasonStats, getNextGame, getOpponent } from '../lib/data';
import { TAGLINE } from '../config';
import { numberIndex } from '../lib/numbers';
import { recordStr, roundName, shortDate, opponentSlug, locationLabel, mapsUrl } from '../lib/format';
const team = getTeam();
const next = getNextGame();
const opp = next ? getOpponent(opponentSlug(next)) : undefined;
const entries = numberIndex(getRoster(), getSeasonStats(), withBase);
const division = (team.classification ?? '').replace(/Division 1$/, 'Division I');
---
<Program>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__top">
      <Logo size={64} class="hero__logo" />
      <div>
        <h1 id="hero-title" class="hero__title">Wilmer-Hutchins <span>Eagles</span></h1>
        <p class="hero__tag">{TAGLINE}</p>
        <p class="hero__meta">
          <span class="hero__record" aria-label={`Record ${recordStr(team.record.overall)}, district ${recordStr(team.record.district)}`}>
            {recordStr(team.record.overall)}
          </span>
          <span class="muted">{recordStr(team.record.district)} district</span>
          <span class="badge badge--hot">Playoffs</span>
        </p>
      </div>
    </div>
    {next && (
      <a class="nextgame" href={withBase('/matchup')}>
        <span class="nextgame__label">Next game{roundName(next) && <> · {roundName(next)}</>}</span>
        <span class="nextgame__vs">vs. {next.opponent.name}{next.opponent.mascot ? ` ${next.opponent.mascot}` : ''}</span>
        <span class="nextgame__meta">
          {next.date ? shortDate(next.date) : 'Date TBA'} · Kickoff TBA{next.venue ? ` · ${next.venue.name}` : !next.date ? ` · ${locationLabel(next.location)}` : ''}
          {opp && <> · {next.opponent.name} {opp.record.overall.w}-{opp.record.overall.l}</>}
        </span>
        <span class="nextgame__cta" aria-hidden="true">Matchup &rarr;</span>
      </a>
    )}
    {next?.venue && <p class="nextgame__where"><a href={mapsUrl(next.venue)} target="_blank" rel="noopener">{next.venue.address}<span class="sr-only"> (opens maps in a new tab)</span></a></p>}
  </section>

  <section id="numbers" class="numbers" aria-labelledby="numbers-title">
    <h2 id="numbers-title" class="section-title">Who is #<span class="section-title__hl">?</span> <span class="muted section-title__sub">Tap a number</span></h2>
    <form class="finder" action={withBase('/roster')} method="get" role="search">
      <label class="sr-only" for="home-q">Search by number or name</label>
      <input class="search" id="home-q" type="search" name="q" inputmode="search" enterkeyhint="go" autocomplete="off" placeholder="Type a number or a name" />
      <button class="btn btn--ghost finder__go" type="submit">Search</button>
    </form>
    <ul class="tiles" id="home-tiles">
      {entries.map((e, i) => (
        <li style={`--i:${Math.min(i, 12)}`}>
          <a class="tile" href={e.href} data-n={e.number}
             data-name={e.players.map((p) => `${p.first} ${p.last}`).join(' | ').toLowerCase()}
             aria-label={`Number ${e.number}, ${e.players.map((p) => `${p.first} ${p.last}`).join(' and ')}`}>
            <span class="tile__n">{e.number}</span>
            <span class="tile__l">{e.players.length > 1 ? `${e.players.length} players` : e.players[0]!.last}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty" id="home-empty" role="status" hidden>No match. Try another number or name.</p>
    <p class="muted numbers__foot">{division} Playoffs · <a href={withBase('/roster')}>Full roster</a></p>
  </section>
</Program>
