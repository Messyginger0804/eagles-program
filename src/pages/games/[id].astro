---
import { withBase } from '../../lib/url';
import Program from '../../layouts/Program.astro';
import BoxScore from '../../components/BoxScore.astro';
import { getGames } from '../../lib/data';
import { gameBadges, longDate, playDesc, takeawayLabel, siteLabel, mapsUrl, WH_NAME, recordStr } from '../../lib/format';

export function getStaticPaths() {
  return getGames().map((g) => ({ params: { id: g.id }, props: { game: g } }));
}
const { game } = Astro.props;
const opp = game.opponent.name;
const q = game.quarters;
const nq = q ? Math.max(q.wh.length, q.opp.length) : 0;
const qLabel = (i: number) => (i < 4 ? `Q${i + 1}` : i === 4 ? 'OT' : `${i - 3}OT`);
const side = (t: 'WH' | 'OPP') => (t === 'WH' ? WH_NAME : opp);
const final = game.status === 'final' && game.score;
const title = `${WH_NAME} vs. ${opp}`;
---
<Program title={title}>
  <p class="backlink"><a href={withBase("/schedule")}>&larr; Schedule</a></p>
  <h1 class="page-title page-title--sm">{title}</h1>
  <p class="muted gmeta">
    {longDate(game.date)} · {siteLabel(game)}
    {gameBadges(game).map((b) => (
      <span class:list={['badge', b.kind === 'playoff' && 'badge--hot', b.kind === 'special' && 'badge--special']}>
        {b.kind === 'special' && <span aria-hidden="true">★ </span>}{b.label}
      </span>
    ))}
  </p>
  {game.venue && <p class="muted gmeta"><a href={mapsUrl(game.venue)} target="_blank" rel="noopener">{game.venue.address}<span class="sr-only"> (opens maps in a new tab)</span></a>{!final && <> · Kickoff TBA</>}</p>}

  {final ? (
    <>
      <section class="scoreboard" aria-label="Final score">
        <div class="scoreboard__team"><span class="scoreboard__abbr">WH</span>{WH_NAME} Eagles</div>
        <div class="scoreboard__score">
          <span class:list={[game.result === 'W' && 'scoreboard__score--win']}>{game.score!.wh}</span>
          <span aria-hidden="true" class="scoreboard__dash">–</span><span class="sr-only"> to </span>
          <span>{game.score!.opp}</span>
        </div>
        <div class="scoreboard__team scoreboard__team--opp"><span class="scoreboard__abbr">{opp.slice(0, 3).toUpperCase()}</span>{opp} {game.opponent.mascot ?? ''}</div>
        <p class="scoreboard__meta">
          <span class={`wl wl--${game.result}`}>{game.result}</span>
          Final · {game.result === 'W' ? 'Win' : game.result === 'L' ? 'Loss' : 'Tie'}{game.recordAfter ? ` · record ${recordStr(game.recordAfter)}` : ''}
        </p>
        {q ? (
          <div class="table-scroll scoreboard__qs" role="region" tabindex="0" aria-label="Quarter scores">
            <table>
              <caption class="sr-only">Score by quarter</caption>
              <thead><tr>
                <th scope="col">Team</th>
                {Array.from({ length: nq }, (_, i) => <th scope="col" class="num">{qLabel(i)}</th>)}
                <th scope="col" class="num">Final</th>
              </tr></thead>
              <tbody>
                <tr><th scope="row">WH</th>{Array.from({ length: nq }, (_, i) => <td class="num">{q.wh[i] ?? 0}</td>)}<td class="num"><strong>{game.score!.wh}</strong></td></tr>
                <tr><th scope="row">{opp}</th>{Array.from({ length: nq }, (_, i) => <td class="num">{q.opp[i] ?? 0}</td>)}<td class="num"><strong>{game.score!.opp}</strong></td></tr>
              </tbody>
            </table>
          </div>
        ) : <p class="muted scoreboard__qs">Quarter scores not reported</p>}
      </section>

      <h2 class="section-title">{game.scoringStatus === 'complete' ? 'Scoring Summary' : game.scoringStatus === 'partial' ? 'Partial scoring summary' : 'Scoring'}</h2>
      {game.scoringStatus === 'none' && <p class="card muted">No play-by-play reported.</p>}
      {game.scoringStatus === 'partial' && <p class="caveat">Partial scoring summary — MaxPreps play log incomplete</p>}
      {game.scoring.length > 0 && (
        <ol class="timeline" aria-label="Scoring plays">
          {game.scoring.map((p) => (
            <li class:list={['tl', p.team === 'WH' ? 'tl--wh' : 'tl--opp']}>
              <span class="tl__when">Q{p.quarter}{p.time ? ` ${p.time}` : ''}</span>
              <span class="tl__body">
                <span class="tl__team">{side(p.team)}</span>
                <span class="tl__play">
                  {p.player ? <>{p.player.name} (#{p.player.number}) </> : null}{playDesc(p)}
                  {p.passer ? <> from {p.passer.name} (#{p.passer.number})</> : null}
                </span>
              </span>
              <span class="tl__score" aria-label={p.scoreAfter ? `Score ${p.scoreAfter.wh} to ${p.scoreAfter.opp}` : 'Score not listed'}>{p.scoreAfter ? `${p.scoreAfter.wh}-${p.scoreAfter.opp}` : '—'}</span>
            </li>
          ))}
        </ol>
      )}

      <h2 class="section-title">Takeaways</h2>
      {game.takeaways.length === 0
        ? <p class="card muted">No takeaways reported.</p>
        : <ul class="bullets">{game.takeaways.map((t) => (
            <li class="card">Q{t.quarter} · {takeawayLabel(t.type)} — {side(t.team)}{t.player ? `: ${t.player.name} (#${t.player.number})` : ''}</li>
          ))}</ul>}

      <BoxScore playerStats={game.playerStats} opponent={opp} />
    </>
  ) : (
    <section class="card">
      <h2 class="section-title">Game Preview</h2>
      <p class="lede">{longDate(game.date)}. Kickoff: TBA. See the full matchup, with both rosters, on the <a href={withBase("/matchup")}>Matchup page</a>.</p>
    </section>
  )}

  <h2 class="section-title">Links</h2>
  <ul class="linklist">
    {game.maxprepsUrl && <li><a class="btn btn--ghost" href={game.maxprepsUrl} rel="noopener">Full game page on MaxPreps</a></li>}
    {game.links.replay && <li><a class="btn btn--ghost" href={game.links.replay} rel="noopener">Replays: NFHS Network</a></li>}
    {game.links.highlights.map((h) => <li><a class="btn btn--ghost" href={h.url} rel="noopener">{h.label}</a></li>)}
  </ul>
</Program>
