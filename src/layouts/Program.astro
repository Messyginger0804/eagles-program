---
import { withBase } from '../lib/url';
import '@fontsource/anton/latin-400.css';
import '@fontsource/oswald/latin-500.css';
import '@fontsource/oswald/latin-700.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import oswaldWoff2 from '@fontsource/oswald/files/oswald-latin-700-normal.woff2?url';
import '../styles/global.css';
import printCss from '../styles/print.css?url';
import Logo from '../components/Logo.astro';
import NumberSheet from '../components/NumberSheet.astro';
import WelcomeSheet from '../components/WelcomeSheet.astro';
import { SITE_TITLE, INDEXABLE, REMOVAL_CONTACT, MAXPREPS_TEAM_URL, THEME_COLOR, PROMO } from '../config';

interface Props { title?: string }
const { title } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const path = Astro.url.pathname.replace(/\/$/, '');
const showWelcome = !(path === withBase('/print').replace(/\/$/, ''));
const noArt = !showWelcome; // /print: no background art
const isHome = path === withBase('/').replace(/\/$/, '');
const is = (href: string) => path === withBase(href).replace(/\/$/, '');
const section = (href: string) => is(href) || path.startsWith(withBase(href).replace(/\/$/, '') + '/');
const moreHrefs = ['/more', '/matchup', '/seniors-coaches', '/print'];
const tabs = [
  { href: '/', label: 'Home', current: is('/'), icon: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { href: '/roster', label: 'Roster', current: section('/roster') || section('/players'), icon: 'M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zM8 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm0 2c-2.3 0-7 1.2-7 3.5V19h14v-2.5C15 14.2 10.3 13 8 13zm8 0c-.3 0-.6 0-1 .1 1.2.8 2 1.9 2 3.4V19h6v-2.5c0-2.3-4.700-3.500-7-3.500z' },
  { href: '/schedule', label: 'Schedule', current: section('/schedule') || section('/games'), icon: 'M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2zM5 9h14v11H5z' },
  { href: '/stats', label: 'Stats', current: section('/stats'), icon: 'M4 20V10h4v10zm6 0V4h4v16zm6 0v-7h4v7z' },
  { href: '/more', label: 'More', current: moreHrefs.some(section), icon: 'M5 10a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="icon" type="image/svg+xml" href={withBase('/brand/icon.svg')} />
    <link rel="icon" type="image/png" sizes="48x48" href={withBase('/brand/favicon-48.png')} />
    <link rel="apple-touch-icon" href={withBase('/brand/apple-touch-icon.png')} />
    <link rel="preload" as="font" type="font/woff2" href={antonWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={oswaldWoff2} crossorigin />
    <link rel="stylesheet" href={printCss} media="print" />
    <script is:inline>
      // View-transition number morph (Chromium; other browsers ignore these events).
      (function () {
        var slug = function (u) { var m = /\/players\/([^\/]+)\/?$/.exec(new URL(u).pathname); return m && m[1]; };
        addEventListener('pageswap', function (e) {
          var k = e.viewTransition && e.activation && e.activation.entry && slug(e.activation.entry.url);
          if (!k) return;
          var sel = '[href$="/players/' + k + '/"]';
          var n = document.querySelector('#numsheet[open] a' + sel);
          n = n ? n.closest('.pcard').querySelector('.pcard__num') : document.querySelector('a.pc' + sel + ' .pc__num');
          if (n) n.style.viewTransitionName = 'num-' + k;
        });
        addEventListener('pagereveal', function (e) {
          var f = e.viewTransition && navigation.activation && navigation.activation.from;
          var k = f && slug(f.url);
          var n = k && document.querySelector('a.pc[href$="/players/' + k + '/"] .pc__num');
          if (!n || n.getBoundingClientRect().top > innerHeight) return;
          n.style.viewTransitionName = 'num-' + k;
          e.viewTransition.finished.then(function () { n.style.viewTransitionName = ''; });
        });
        addEventListener('pageshow', function (e) {
          if (e.persisted) document.querySelectorAll('[style*="view-transition-name"]').forEach(function (n) { n.style.viewTransitionName = ''; });
        });
      })();
    </script>
  </head>
  <body class={noArt ? 'no-art' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__in">
        <a class="brand" href={withBase('/')} aria-label="WH Eagles, home">
          <Logo size={44} />
          <span class="brand__text"><span class="brand__main">WH Eagles</span><span class="brand__sub">Game Day</span></span>
        </a>
        <nav aria-label="Main" class="topnav">
          <ul>
            {tabs.map((t) => <li><a href={withBase(t.href)} aria-current={t.current ? 'page' : undefined}>{t.label}</a></li>)}
          </ul>
        </nav>
        <a class="findnum" href={withBase('/#numbers')} data-open-numbers aria-haspopup="dialog">
          <span aria-hidden="true">#</span> Find a number
        </a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <nav aria-label="More pages" class="site-footer__links">
        <a href={withBase('/matchup')}>Matchup</a>
        <a href={withBase('/seniors-coaches')}>Seniors &amp; Coaches</a>
        <a href={withBase('/print')}>Print</a>
        <a href={MAXPREPS_TEAM_URL} rel="noopener">MaxPreps</a>
      </nav>
      <p>
        Unofficial fan site — not affiliated with Wilmer-Hutchins High School or Dallas ISD.
        Stats via <a href={MAXPREPS_TEAM_URL} rel="noopener">MaxPreps</a>.
      </p>
      <p>
        {REMOVAL_CONTACT
          ? <>Removal requests: <a href={`mailto:${REMOVAL_CONTACT}`}>{REMOVAL_CONTACT}</a></>
          : <>Removal requests and name fixes: <a href={withBase('/fix-a-name')}>Fix a Name</a></>}
      </p>
      <p class="site-footer__art">Background art: official 2026 schedule graphic by BLAC</p>
      {PROMO.enabled && <p class="site-footer__credit">Site by <a href={PROMO.footerUrl} target="_blank" rel="noopener">DFW Software Consulting</a></p>}
    </footer>

    {!isHome && <a class="fab" href={withBase('/#numbers')} data-open-numbers aria-haspopup="dialog" aria-label="Find a player by number">
      <span aria-hidden="true">#</span>
    </a>}
    <nav class="tabbar" aria-label="Main">
      <ul>
        {tabs.map((t) => (
          <li>
            <a href={withBase(t.href)} aria-current={t.current ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={t.icon} fill="currentColor" /></svg>
              <span>{t.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <NumberSheet />
    {showWelcome && <WelcomeSheet />}
  </body>
</html>
