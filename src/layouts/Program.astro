---
import { withBase } from '../lib/url';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/700.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/400-italic.css';
import '@fontsource/source-sans-3/700.css';
import '../styles/global.css';
import printCss from '../styles/print.css?url';
import { SITE_TITLE, INDEXABLE, REMOVAL_CONTACT, MAXPREPS_TEAM_URL } from '../config';

interface Props { title?: string }
const { title } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const path = Astro.url.pathname.replace(/\/$/, "");
const nav = [
  { href: '/', label: 'Cover' },
  { href: '/roster', label: 'Roster' },
  { href: '/matchup', label: 'Matchup' },
  { href: '/schedule', label: 'Schedule' },
  { href: '/stats', label: 'Stats' },
  { href: '/seniors-coaches', label: 'Seniors & Coaches' },
  { href: '/print', label: 'Print' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    <link rel="stylesheet" href={printCss} media="print" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={withBase("/")} aria-label="Eagles game day program, home">
        <span class="wordmark__main">EAGLES</span>
        <span class="wordmark__sub">Game Day Program</span>
      </a>
      <nav aria-label="Program sections">
        <ul class="nav">
          {nav.map((n) => (
            <li><a href={withBase(n.href)} aria-current={path === withBase(n.href).replace(/\/$/, "") ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p>
        Unofficial fan site — not affiliated with Wilmer-Hutchins High School or Dallas ISD.
        Stats via <a href={MAXPREPS_TEAM_URL} rel="noopener">MaxPreps</a>.
      </p>
      <p>
        {REMOVAL_CONTACT
          ? <>Removal requests: <a href={`mailto:${REMOVAL_CONTACT}`}>{REMOVAL_CONTACT}</a></>
          : 'Removal requests: contact form coming soon'}
      </p>
    </footer>
  </body>
</html>
